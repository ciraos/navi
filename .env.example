# ============================================================
#  Navi 导航站 — 环境变量模板（Next.js 全栈）
#  复制成 .env 后按需修改：  Copy-Item .env.example .env
# ============================================================

# ─── 运行环境 ───────────────────────────────────────────────
APP_ENV=development

# ─── 数据库 ─────────────────────────────────────────────────
# PostgreSQL 连接串。兼容旧的 postgresql+psycopg:// 前缀。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/navi

# ─── 认证 / JWT ─────────────────────────────────────────────
# 生产环境务必换成随机值，例如：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=please-change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
# token 有效期（分钟），默认 7 天
JWT_EXPIRE_MINUTES=10080
COOKIE_NAME=navi_token
# 生产环境走 HTTPS 时改成 true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─── 站点信息 ───────────────────────────────────────────────
SITE_NAME=Navi 导航
SITE_DESCRIPTION=一个轻量、干净的个人导航站

# 部署域名，用于 sitemap / RSS / Atom 的绝对地址
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 深浅色自动切换的位置，默认上海
NEXT_PUBLIC_SITE_LATITUDE=31.2304
NEXT_PUBLIC_SITE_LONGITUDE=121.4737
